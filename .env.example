# ============================================================
# 校园电费监控 - 环境变量模板（校园e码通 / 建行电控电表）
# 使用：复制为 .env 后填写（.env 已在 .gitignore，不会进仓库）
# 敏感信息（USERID / SKEY / Cookie / Webhook）只能放在 .env，禁止写进代码。
# ============================================================

# ---------- 建行校园一卡通凭据与目标宿舍（Phase 1 抓包后填写） ----------
# 一卡通用户编号（抓包请求体中的 USERID）
CCB_USERID=
# 当前会话校验密钥（抓包请求体中的 SKEY）
CCB_SKEY=
# 固化后的宿舍房间号（如 134-33--250-501，来自抓包请求体 roomid）
CCB_ROOMID=

# ---------- 会话 Cookie（抓包请求头 Cookie 的完整内容） ----------
# 抓包请求头 Cookie 粘贴到这里，如 TC=xxx; IN001=xxx; CCBIBS1=xxx; tgw_l7_route=xxx
# 可留空；若查询失败请补全。服务端每次响应会通过 Set-Cookie 下发新的
# CCBIBS1 / IN001，程序使用 httpx.Client 会话自动维护，无需手工更新本项。
CCB_COOKIE=

# ---------- 可选 ----------
# 宿舍显示名（仅用于推送展示，如 "40栋-501"）
CCB_ROOM_NAME=
# 覆盖默认微信 UA（一般无需修改；抓包中 User-Agent 原样粘贴）
CCB_USER_AGENT=
# 网关地址覆盖（仅当接口迁移或本地联调时设置，默认使用内置地址）
CCB_GATEWAY_URL=

# ---------- 阈值与告警（单位与响应 meterflag 一致，如：度） ----------
# 一级阈值：低于该值每日最多提醒一次
WARN_THRESHOLD=20.0
# 二级阈值：低于该值每次运行都提醒（设为 0 表示禁用）
CRITICAL_THRESHOLD=5.0
# 一级阈值是否每日只提醒一次
WARN_ONCE_PER_DAY=true

# ---------- 推送渠道（按需选填其一；不填 PUSH_CHANNEL 则自动推断） ----------
# 显式指定：wecom / pushplus / serverchan / bark / none；留空则按已填凭据自动推断
PUSH_CHANNEL=
# 企业微信群机器人 Webhook（PUSH_CHANNEL=wecom 时必填）
WECOM_WEBHOOK=
# PushPlus token（PUSH_CHANNEL=pushplus 时必填）
PUSHPLUS_TOKEN=
# Server酱 SendKey（PUSH_CHANNEL=serverchan 时必填）
SERVERCHAN_KEY=
# Bark 推送地址（PUSH_CHANNEL=bark 时必填，形如 https://api.day.app/设备密钥）
BARK_URL=

# ---------- 运行参数 ----------
# HTTP 超时（秒）
REQUEST_TIMEOUT=10
# 请求失败重试次数（0-2，默认 2；遵守接口频率限制，禁止调高）
MAX_RETRIES=2
# 保活节奏说明（keep_alive.py）：因会话空闲超时 <30 分钟，需保活时用
# `python keep_alive.py --interval 600`（≈144 次/天，间隔下限 60 秒）
# 告警判定使用的时区（在 GitHub Actions 等 UTC 环境里避免日期错位）
ALERT_TZ=Asia/Shanghai
# 是否遵循系统代理（1 是 / 0 否）；接口仅限校园网直连时设为 0
TRUST_ENV=1
