# 真实凭据与环境（禁止提交）
.env

# 本地运行状态与 SQLite 历史归档（每次运行自动更新，不入库）
state.json
history.db
history.db-wal
history.db-shm

# 会话 Cookie 轮换持久化 / 保活进程锁与日志（含轮转备份 .log.1/.log.2/.log.3）
cookies.json
keepalive.lock
keepalive.pid
keepalive.log
keepalive.log.*
ttl_log.txt

# 计划任务启动脚本（本机专用）
start_keepalive.bat

# 抓包分析产物（含个人数据与第三方前端包，不入库）
tools/h5/
tools/gas_js/
tools/dump_full.txt
tools/dump_*.txt
tools/transactions.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.tmp